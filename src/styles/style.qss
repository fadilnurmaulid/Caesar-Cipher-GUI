/* style.qss */

/* ==========
     GLOBAL   
   ========== */



/* ==========
    HOMEPAGE   
   ========== */


#home_page QPushButton, 
#home_page QLabel{
    padding: 10px;
    border: 2px solid black;  
    border-radius: 5px;
}
#home_page QLabel{
    letter-spacing: 2px;               
    font-size: 65px;
    background-color: hsl(80, 190, 80);
    padding: 6px 12px;
}
#home_page QPushButton{
    font-family: "Segoe UI";
    font-size: 40px;
    background-color: gray;          
}
#home_page QPushButton:hover{
    background-color: hsl(0, 0, 88);               
}
#home_page QPushButton:pressed{
    background-color: hsl(0, 0, 80); 
}


/* =============
    ENCRYPTPAGE   
   ============= */


#encrypt_page QPushButton#back_btn{
    padding: 10px;
    border: 2px solid black;  
    border-radius: 5px;
    font-size: 30px;
    background-color: gray;
}
#encrypt_page QPushButton:hover#back_btn{
    background-color: hsl(0, 0, 88);
}
#encrypt_page QPushButton:pressed#back_btn{
    background-color: hsl(0, 0, 80);               
}
#encrypt_page QPushButton#minus_btn, #encrypt_page QPushButton#plus_btn{
    background-color: #f0f0f0;
    border: 1px solid hsl(0, 0, 80);
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12pt;
    color: #333;            
}
#encrypt_page QPushButton:hover#minus_btn, #encrypt_page QPushButton:hover#plus_btn{
    background-color: hsl(210, 60, 92);
    border: 1px solid hsl(210, 60, 60)               
}
#encrypt_page QPushButton:pressed#minus_btn, #encrypt_page QPushButton:pressed#plus_btn{
    background-color: hsl(210, 60, 80);               
}
#encrypt_page QPushButton:disabled#minus_btn, #encrypt_page QPushButton:disabled#plus_btn{
    background-color: #e0e0e0;
    color: #999999;
    border: 1px solid hsl(0, 0, 75);               
}
#encrypt_page QPushButton#encrypt_btn{
    background-color: hsl(210, 100, 55);
    border: 1px solid hsl(210, 100, 40);
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 13pt;
    color: white;
}
#encrypt_page QPushButton:hover#encrypt_btn{
    background-color: hsl(210, 100, 65);
    border: 1px solid hsl(210, 100, 50);
}
#encrypt_page QPushButton:pressed#encrypt_btn{
    background-color: hsl(210, 100, 45);
    border: 1px solid hsl(210, 100, 35);
}
#encrypt_page QPushButton:disabled#encrypt_btn{
    background-color: #cccccc;
    border: 1px solid #aaaaaa;
    color: #666666;               
}
#encrypt_page QPushButton#reset_btn{
    background-color: #f5f5f5;
    border: 1px solid hsl(0, 0, 75);
    border-radius: 5px;
    padding: 5px 12px;
    font-size: 12pt;
    color: #333333;    
}
#encrypt_page QPushButton:hover#reset_btn{
    background-color: hsl(0, 0%, 88%);
    border: 1px solid hsl(0, 0%, 65%);
}
#encrypt_page QPushButton:pressed#reset_btn{
    background-color: hsl(0, 0%, 80%);
    border: 1px solid hsl(0, 0%, 60%);
}
#encrypt_page QPushButton:disabled#reset_btn{
    background-color: #e0e0e0;
    color: #999999;
    border: 1px solid hsl(0, 0%, 75%);
}
#encrypt_page QLabel#shift_value_lbl, #encrypt_page QLabel#shift_lbl{
    font-size: 12pt;
    color: #222;
}
#encrypt_page QLabel#title_lbl{
    padding: 10px;
    border: 2px solid black;  
    border-radius: 5px;
    background-color: hsl(80, 190, 80);
    font-size: 30px;
}
#encrypt_page QCheckBox#random_cbx{
    font-size: 12pt;
    color: #202020;
}
#encrypt_page QCheckBox::indicator#random_cbx{
    width: 16px;
    height: 16px;
    border: 1px solid hsl(0, 0, 60);
    border-radius: 3px;
    background-color: #f5f5f5;               
}
#encrypt_page QCheckBox::indicator:checked#random_cbx{
    background-color: hsl(210, 100, 60);          
}
#encrypt_page QCheckBox:hover#random_cbx{
    color: hsl(210, 100, 40);               
}
#encrypt_page QTextEdit#txt_input{
    background-color: #ffffff;
    border: 1px solid hsl(0, 0, 80);
    border-radius: 6px;
    padding: 6px;
    font-size: 13pt;
    color: #202020;
}
#encrypt_page QTextEdit:focus#txt_input{
    border: 1.5px solid hsl(210, 100, 60);
    background-color: #fcfcfc;               
}
#encrypt_page QTextEdit#txt_output{
    background-color: #f9f9f9;
    border: 1px solid hsl(0, 0, 80);
    border-radius: 6px;
    padding: 8px 10px;
    font-size: 13pt;
    color: #202020;
}
#encrypt_page QTextEdit:disabled#txt_output{
    background-color: #f0f0f0;
    color: #999999;
    border: 1px solid hsl(0, 0, 75);               
}


